rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can read and write only their own note, in the shape the
    // app writes it. Everything else in the database is closed.
    match /users/{userId}/notes/{noteId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['v', 'text', 'nonce', 'lineage', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 900000
        && request.resource.data.nonce is string
        && request.resource.data.lineage is list
        && request.resource.data.lineage.size() <= 32
        && request.resource.data.updatedAt is number;
    }
  }
}
