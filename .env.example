# Copy this file to .env.local and fill it in.
# Without the Firebase values the app still runs, saving in the browser only.

# Firebase console › Project settings › General › Your apps › SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Sign-in provider: google (default), microsoft, apple, github,
# or a SAML/OIDC provider ID from the Firebase console, such as saml.okta or oidc.okta
VITE_AUTH_PROVIDER=google

# Microsoft only: limit sign-in to one Microsoft Entra tenant (its directory ID)
VITE_AUTH_TENANT=
